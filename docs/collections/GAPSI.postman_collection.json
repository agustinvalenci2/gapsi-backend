{
  "info": {
    "name": "GAPSI - Usuarios e incidencias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden: Health, Auth, Incidencias. Genera un usuario nuevo por ejecucion, guarda JWT e ID. Registro crea datos persistentes; eliminar solo borra la incidencia de ejemplo."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "generate_user",
      "value": "true",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "PostmanDemo123!",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "incident_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 - Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"generate_user\") === \"true\") {",
                  "  const username = \"postman_\" + pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\");",
                  "  pm.collectionVariables.set(\"username\", username);",
                  "  pm.collectionVariables.set(\"email\", username + \"@example.com\");",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - Login y guardar JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"access_token\", data.access_token);",
                  "  pm.test(\"Token Bearer\", () => pm.expect(data.token_type).to.eql(\"bearer\"));",
                  "} else { pm.collectionVariables.unset(\"access_token\"); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 - Mi usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Incidencias",
      "item": [
        {
          "name": "01 - Crear incidencia y guardar ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/incidents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Error al ingresar\",\n  \"description\": \"La pagina muestra un error\",\n  \"priority\": \"high\",\n  \"status\": \"pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"incident_id\", pm.response.json().id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - Listar mis incidencias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/incidents?offset=0&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 - Consultar incidencia",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/incidents/{{incident_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04 - Actualizar incidencia",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/incidents/{{incident_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Error al ingresar\",\n  \"description\": \"La pagina muestra un error\",\n  \"priority\": \"high\",\n  \"status\": \"done\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05 - Resumen por estado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/incidents/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Total coincide con los estados\", () => pm.expect(data.total).to.eql(data.by_status.pending + data.by_status.done + data.by_status.rejected));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "06 - Eliminar incidencia",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/v1/incidents/{{incident_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "07 - Verificar eliminacion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/incidents/{{incident_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
